[project]
site_name = "{{ project_name }}"
site_description = "{{ description }}"
site_url = "https://{{ github_owner }}.github.io/{{ repo_name }}/"
repo_url = "https://github.com/{{ github_owner }}/{{ repo_name }}"
repo_name = "{{ github_owner }}/{{ repo_name }}"
strict = true
nav = [
  { Home = "index.md" },
{% if 'service' in profiles %}
  { "HTTP API" = "http-api.md" },
{% endif %}
{% if 'cli' in profiles %}
  { "Command line" = "command-line.md" },
{% endif %}
{% if 'data' in profiles %}
  { Notebooks = [
    { Example = "notebook.md" },
  ] },
{% endif %}
{% if 'proofs' in features %}
  { Proofs = [
    { Example = "example-proof.md" },
  ] },
{% endif %}
  { "API reference" = "api.md" },
  { Changelog = "changelog.md" },
]

[project.theme]
features = [
  "content.code.copy",
  "navigation.instant",
  "navigation.sections",
  "navigation.top",
  "search.highlight",
]

[[project.theme.palette]]
media = "(prefers-color-scheme)"
toggle.icon = "lucide/sun-moon"
toggle.name = "Switch to light mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
toggle.icon = "lucide/moon"
toggle.name = "Switch to system preference"

[project.markdown_extensions]
admonition = {}
tables = {}
toc.permalink = true
pymdownx.superfences = {}
pymdownx.snippets.check_paths = true

[project.plugins.mkdocstrings.handlers.python]
paths = ["src"]

[project.plugins.mkdocstrings.handlers.python.options]
docstring_style = "numpy"
show_root_heading = true
show_source = false
members_order = "source"
merge_init_into_class = true
heading_level = 3
