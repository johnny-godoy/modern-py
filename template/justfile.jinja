# The one entry point for people, agents and CI. Run `just` to list the recipes.
set shell := ["bash", "-euo", "pipefail", "-c"]

# List the recipes.
default:
    @just --list

# Install the locked environment and the git hooks.
sync:
    uv sync --frozen
    uv run --frozen prek install

# Run every prek hook on every file: lint, format, types, layout, design rules and the workarounds check.
check *args:
    uv run --frozen prek run --all-files {% raw %}{{args}}{% endraw %}

# Run the unit tests with the 100% branch coverage gate.
test *args:
    uv run --frozen pytest {% raw %}{{args}}{% endraw %}

# Run one test, or one test file, without the coverage gate.
test-one target:
    uv run --frozen pytest --no-cov {% raw %}{{target}}{% endraw %}

# Mutate the modules that changed since a base revision. CI requires zero surviving mutants.
mutate base="origin/main":
    uv run --frozen python scripts/mutation.py --base {% raw %}{{base}}{% endraw %}

# Mutate every module, as the weekly workflow does.
mutate-all:
    uv run --frozen python scripts/mutation.py

# Mutate the named modules, for example `just mutate-module src/{{ package_name }}/domain/summary.py`.
mutate-module +modules:
    uv run --frozen python scripts/mutation.py $(printf -- '--module %s ' {% raw %}{{modules}}{% endraw %})

# Build the docs as CI does: strict, and it fails on a docstring warning.
docs:
    uv run --frozen --group docs python -m scripts.build_docs

# Preview the docs on a local server.
docs-serve:
    uv run --frozen --group docs python -m scripts.build_docs serve

# Add a changelog fragment for a change that users can see.
changelog:
    uv run --frozen scriv create
{% if 'service' in profiles %}

# Start the web service with Granian on http://127.0.0.1:8000.
serve port="8000":
    uv run --frozen granian --interface asgi --factory --port {% raw %}{{port}}{% endraw %} {{ package_name }}.api.app:create_app
{% endif %}
{% if 'db' in features %}

# Run the database migrations on the database of DATABASE_URL.
migrate:
    uv run --frozen piccolo migrations forwards all

# Run the database tests on the database of DATABASE_URL, which CI sets to a PostgreSQL service.
test-db:
    PICCOLO_CONF=piccolo_conf uv run --frozen pytest --no-cov tests/unit/{{ package_name }}/adapters/test_summary_store.py
{% endif %}
{% if 'proofs' in features %}

# Check the Lean proofs. Needs elan; see proofs/README.md.
proofs:
    cd proofs && lake build
{% endif %}
