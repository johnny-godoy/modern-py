def reads(path):
    # ruleid: {{ rule_prefix }}-domain-does-no-io
    return path.read_text()


def shows(x):
    # ruleid: {{ rule_prefix }}-domain-does-no-io
    print(x)


# ruleid: {{ rule_prefix }}-no-manual-beartype
@beartype
def decorated(x):
    return x


def bare_error(x):
    if x < 0:
        # ruleid: {{ rule_prefix }}-no-bare-value-error
        raise ValueError("negative")
    if x > 9:
        # ruleid: {{ rule_prefix }}-no-bare-value-error
        raise ValueError("large") from None
    # ruleid: {{ rule_prefix }}-no-bare-value-error
    raise ValueError


def own_error(x):
    if x < 0:
        # ok: {{ rule_prefix }}-no-bare-value-error
        raise EmptyInputError("negative")
    try:
        return int(x)
    except ValueError:
        # ok: {{ rule_prefix }}-no-bare-value-error
        raise


