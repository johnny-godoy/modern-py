{% set service = 'service' in profiles %}
{% set data = 'data' in profiles %}
{% set cli = 'cli' in profiles %}
{% set entry = [] %}
{% if service %}{% set _ = entry.append(package_name ~ '.api') %}{% endif %}
{% if cli %}{% set _ = entry.append(package_name ~ '.cli') %}{% endif %}
{% set vendors = [] %}
{% if service %}{% set _ = vendors.extend(['aiohttp', 'stamina']) %}{% endif %}
{% if data %}{% set _ = vendors.append('duckdb') %}{% endif %}
{% if 'db' in features %}{% set _ = vendors.extend(['piccolo', 'asyncpg']) %}{% endif %}
{% if 'ml' in features %}{% set _ = vendors.extend(['onnx', 'onnxruntime', 'skl2onnx', 'skops']) %}{% endif %}
{% if 'aws' in features %}{% set _ = vendors.append('aioboto3') %}{% endif %}
[project]
name = "{{ distribution_name }}"
version = "0.0.0"
description = "{{ description }}"
readme = "README.md"
{% if license != 'Proprietary' %}
license = "{{ license }}"
license-files = ["LICENSE"]
{% endif %}
classifiers = [
    "Development Status :: 3 - Alpha",
{% if license == 'Proprietary' %}
    "Private :: Do Not Upload",
{% endif %}
    "Programming Language :: Python :: {{ python_version }}",
    "Typing :: Typed",
]
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
requires-python = ">={{ python_version }}"
dependencies = [
{% if 'aws' in features %}
    "aioboto3>=15.5.0",
{% endif %}
{% if service %}
    "aiohttp>=3.14.5",
{% endif %}
{% if service or 'db' in features or 'aws' in features %}
    "anyio>=4.15.1",
{% endif %}
    "attrs>=26.1.0",
    "beartype>=0.23.1",
{% if cli %}
    "cyclopts>=5.2.0",
{% endif %}
{% if data %}
    "duckdb>=1.5.6",
{% endif %}
{% if service %}
    "granian>=2.8.4",
    "litestar>=2.25.0",
    "msgspec>=0.22.0",
{% endif %}
{% if 'ml' in features %}
    "onnx>=1.23.2",
    "onnxruntime>=1.31.0",
{% endif %}
    "orjson>=3.13.0",
{% if 'db' in features %}
    "piccolo[postgres]>=1.36.0",
{% endif %}
{% if data %}
    "polars>=2.0.0",
    # duckdb converts a result to a polars frame through Arrow
    "pyarrow>=26.0.0",
{% endif %}
{% if 'ml' in features %}
    "skl2onnx>=1.20.0",
    "skops>=0.16.0",
{% endif %}
{% if service %}
    "stamina>=26.1.0",
{% endif %}
{% if 'text' in features %}
    "stringzilla>=5.3.1",
{% endif %}
    "structlog>=26.1.0",
]
{% if cli %}

[project.scripts]
{{ distribution_name }} = "{{ package_name }}.cli.app:main"
{% endif %}

[project.urls]
Documentation = "https://{{ github_owner }}.github.io/{{ repo_name }}/"
Source = "https://github.com/{{ github_owner }}/{{ repo_name }}"
Issues = "https://github.com/{{ github_owner }}/{{ repo_name }}/issues"
Changelog = "https://github.com/{{ github_owner }}/{{ repo_name }}/blob/main/CHANGELOG.md"

[tool.uv]
# A relative span keeps the cutoff 7 days behind today, so uv never picks a release that is less than 7 days old.
exclude-newer = "7 days"

[build-system]
requires = ["uv_build>=0.11.0,<0.12.0"]
build-backend = "uv_build"

[tool.ruff]
# reason: semgrep/rules.py holds bad code on purpose, as test data for the semgrep rules, and a fix by ruff would break
# the annotations that semgrep reads.
force-exclude = true
exclude = [
    "semgrep",
    ".git",
    ".venv",
    "build",
    "dist",
    "site",
]
fix = true
preview = true
line-length = 120
src = ["src"]
target-version = "py{{ python_version | replace('.', '') }}"
unsafe-fixes = true

[tool.ruff.format]
docstring-code-format = true
docstring-code-line-length = "dynamic"
preview = true

[tool.ruff.lint]
# reason: copyright notices are an unusual requirement that this project does not impose on its source files. The
# typing-only import rules are a recurring pattern: beartype reads every annotation of the package at run time, so an
# import that only a hint uses is a run-time import, and a TYPE_CHECKING block would break the check.
ignore = [
    "missing-copyright-notice",
    "typing-only-first-party-import",
    "typing-only-standard-library-import",
    "typing-only-third-party-import",
]
preview = true
select = ["ALL"]

[tool.ruff.lint.per-file-ignores]
# reason: recurring pattern in tests/: pytest tests use bare assert, literal expected values and private members by design,
# and are not public API, so docstrings are not required.
"tests/**/*.py" = ["undocumented-public-function", "magic-value-comparison", "assert", "private-member-access"]
{% if data %}
# reason: every cell of a marimo notebook is a function that takes the names it uses as arguments, imports inside the
# first cell and shows its last expression, so these rules would fire in every cell of notebooks/.
"notebooks/**/*.py" = [
    "missing-type-function-argument",
    "missing-return-type-private-function",
    "import-outside-top-level",
    "invalid-argument-name",
    "useless-expression",
    "too-many-arguments",
    "too-many-positional-arguments",
]
{% endif %}

# BEGIN banned-api: generated by scripts/sync_banned.py from scripts/banned.toml. Do not edit by hand.
[tool.ruff.lint.flake8-tidy-imports.banned-api]
"argparse".msg = "Use cyclopts. See .claude/rules/libraries.md."
"arrow".msg = "Use whenever. See .claude/rules/libraries.md."
"backoff".msg = "Use stamina. See .claude/rules/libraries.md."
"boto3".msg = "Use aioboto3. See .claude/rules/libraries.md."
"click".msg = "Use cyclopts. See .claude/rules/libraries.md."
"cloudpickle".msg = "Use msgspec, orjson. See .claude/rules/libraries.md."
"dataclasses".msg = "Use attrs. See .claude/rules/libraries.md."
"dill".msg = "Use msgspec, orjson. See .claude/rules/libraries.md."
"django".msg = "Use Litestar. See .claude/rules/libraries.md."
"fastapi".msg = "Use Litestar. See .claude/rules/libraries.md."
"flask".msg = "Use Litestar. See .claude/rules/libraries.md."
"httpx".msg = "Use aiohttp. See .claude/rules/libraries.md."
"joblib".msg = "Use msgspec, orjson. See .claude/rules/libraries.md."
"json".msg = "Use orjson. See .claude/rules/libraries.md."
"logging".msg = "Use structlog. See .claude/rules/libraries.md."
"loguru".msg = "Use structlog. See .claude/rules/libraries.md."
"pandas".msg = "Use polars. See .claude/rules/libraries.md."
"peewee".msg = "Use Piccolo. See .claude/rules/libraries.md."
"pendulum".msg = "Use whenever. See .claude/rules/libraries.md."
"pickle".msg = "Use msgspec, orjson. See .claude/rules/libraries.md."
"pydantic".msg = "Use msgspec. See .claude/rules/libraries.md."
"pydantic_settings".msg = "Use msgspec. See .claude/rules/libraries.md."
"pytz".msg = "Use whenever. See .claude/rules/libraries.md."
"requests".msg = "Use aiohttp. See .claude/rules/libraries.md."
"shelve".msg = "Use msgspec, orjson. See .claude/rules/libraries.md."
"simplejson".msg = "Use orjson. See .claude/rules/libraries.md."
"sqlalchemy".msg = "Use Piccolo. See .claude/rules/libraries.md."
"sqlmodel".msg = "Use Piccolo. See .claude/rules/libraries.md."
"starlette".msg = "Use Litestar. See .claude/rules/libraries.md."
"tenacity".msg = "Use stamina. See .claude/rules/libraries.md."
"tortoise".msg = "Use Piccolo. See .claude/rules/libraries.md."
"typeguard".msg = "Use beartype. See .claude/rules/libraries.md."
"typer".msg = "Use cyclopts. See .claude/rules/libraries.md."
"ujson".msg = "Use orjson. See .claude/rules/libraries.md."
"urllib3".msg = "Use aiohttp. See .claude/rules/libraries.md."
# END banned-api

[dependency-groups]
dev = [
{% if 'db' in features %}
    "aiosqlite>=0.22.1",
{% endif %}
{% if data %}
    "altair>=6.3.0",
{% endif %}
    "cosmic-ray>=8.7.0",
    "hypothesis>=6.170.1",
    "import-linter>=2.15",
{% if data %}
    "marimo>=0.25.1",
{% endif %}
{% if 'aws' in features %}
    "moto[server]>=5.2.4",
{% endif %}
    "prek>=0.5.5",
    "pyrefly>=1.4.0",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "pyyaml>=6.0.3",
    "ruff>=0.17.1",
{% if 'ml' in features %}
    "scikit-learn>=1.9.1",
{% endif %}
    "semgrep>=1.181.0",
{% if 'aws' in features %}
    "types-aioboto3[s3]>=15.5.0",
{% endif %}
    "types-pyyaml>=6.0.12.20260906",
{% if 'proofs' in features %}
    "typst>=0.15.0",
{% endif %}
    "vulture>=2.16",
    { include-group = "commits" },
    { include-group = "release" },
]
docs = [
    "mkdocstrings[python]>=1.0.7",
    "zensical>=0.0.71",
]
# the commit-msg hook and the commits workflow install only this group to check commit messages
commits = [
    "commitizen>=4.19.2",
]
# the release workflow installs only this group to collect the changelog fragments
release = [
    "scriv>=1.8.0",
]

[tool.vulture]
# reason: fixtures are used through pytest's name-based injection, which vulture cannot see.
ignore_decorators = ["@pytest.fixture"]
# reason: pytest reads pytestmark and the pytest_* hooks of a conftest.py by name, code never references them, so vulture
# reports them as unused.
ignore_names = ["pytestmark", "pytest_*"]

[tool.pytest.ini_options]
testpaths = ["tests/unit"]
addopts = "--cov={{ package_name }} --cov-report=term-missing"
# reason: beartype skips a function it cannot decorate and only warns, so the warning must fail the tests.
filterwarnings = ["error::beartype.roar.BeartypeClawDecorWarning"]

[tool.coverage.run]
branch = true
source = ["{{ package_name }}"]

[tool.coverage.report]
fail_under = 100
show_missing = true

[tool.importlinter]
root_package = "{{ package_name }}"
{% if vendors %}
# External packages are needed so that a contract can forbid the vendor SDKs.
include_external_packages = true
{% endif %}

[[tool.importlinter.contracts]]
name = "Layers: {{ (entry | map('replace', package_name ~ '.', '') | join(' and ') ~ ' over ') if entry else '' }}adapters over domain over core"
type = "layers"
layers = [
{% if entry %}
    "{{ entry | join(' | ') }}",
{% endif %}
    "{{ package_name }}.adapters",
    "{{ package_name }}.domain",
    "{{ package_name }}.core",
]
{% if vendors %}

[[tool.importlinter.contracts]]
name = "Only the adapters import the vendor SDKs"
type = "forbidden"
source_modules = [
{% for module in entry %}
    "{{ module }}",
{% endfor %}
    "{{ package_name }}.domain",
    "{{ package_name }}.core",
]
forbidden_modules = [
{% for vendor in vendors %}
    "{{ vendor }}",
{% endfor %}
]
{% endif %}

[tool.pyrefly]
# The strict preset reports implicit `Any` in parameters, lambdas, attributes, empty containers and type arguments.
preset = "strict"
# The repository root holds the `scripts` and `tests` packages. A config turns off the guessed fallback search path.
search-path = ["src", "."]

# Raise the checks below to errors, because the strict preset leaves them off or at warning level. Three checks stay
# off. implicit-bool: ruff prefers `if items:` to `if len(items) > 0:`. unused-call-result: an unused result, such as
# the count from `Path.write_bytes`, is not a defect. explicit-any: parsed TOML and JSON have no static type, and the
# strict preset already reports each implicit `Any`.
# The ignore check reads each key of this table as a workaround, so each key has a reason. No key silences an error.
[tool.pyrefly.errors]
# reason: raised to an error because a submodule used without its own import breaks when the import order changes.
implicit-import = "error"
# reason: raised to an error because a name imported from a module that does not export it can disappear in a release.
implicit-reexport = "error"
# reason: raised to an error because an attribute first set outside __init__ is missing until that method runs.
implicitly-defined-attribute = "error"
# reason: raised to an error because an override without @override does not fail when the base method is renamed.
missing-override-decorator = "error"
# reason: raised to an error because a function that returns Any hides the real type from each caller.
no-any-return = "error"
# reason: raised to an error because a match that misses a case of an enum or Literal falls through without notice.
non-exhaustive-match = "error"
# reason: raised to an error because a cast to the type that the value already has hides nothing and only adds noise.
redundant-cast = "error"
# reason: raised to an error because a condition that is always true or always false is dead code or a bug.
redundant-condition = "error"
# reason: raised to an error because an argument of implicit Any type turns off the check of the parameter.
unknown-argument-type = "error"
# reason: raised to an error because an attribute of implicit Any type turns off the checks of each use.
unknown-attribute-access = "error"
# reason: raised to an error because an attribute of implicit Any type turns off the checks of each use.
unknown-attribute-type = "error"
# reason: raised to an error because a call result of implicit Any type turns off the checks of each use.
unknown-return-type = "error"
# reason: raised to an error because a variable of implicit Any type turns off the checks of each use.
unknown-variable-type = "error"
# reason: raised to an error because a comparison whose result is known before it runs is a bug in the logic.
unnecessary-comparison = "error"
# reason: raised to an error because a conversion to the type that the value already has is dead code.
unnecessary-type-conversion = "error"
# reason: raised to an error because an untyped class decorator replaces the class type with Any.
untyped-class-decorator = "error"
# reason: raised to an error because an untyped function decorator replaces the signature with Any.
untyped-function-decorator = "error"
# reason: raised to an error because a package with no types makes each of its names Any, so add its stubs.
untyped-import = "error"
# reason: raised to an error because an ignore that silences nothing must go, so that no stale ignore stays.
unused-ignore = "error"

# reason: .claude/rules/prek-and-ignores.md freezes scripts/ignore_sites.py, so its code cannot change, and an inline
# ignore is an edit too. Its walk of the untyped ast and tomllib trees gives these three errors. All other checks still
# apply to the file.
[[tool.pyrefly.sub-config]]
matches = "scripts/ignore_sites.py"
errors = { missing-attribute = false, unknown-argument-type = false, unknown-variable-type = false }

[tool.scriv]
format = "md"
fragment_directory = "changelog.d"
categories = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
md_header_level = "2"
version = "literal: pyproject.toml: project.version"
entry_title_template = "[{{ '{{' }} version {{ '}}' }}] - {{ '{{' }} date.strftime('%Y-%m-%d') {{ '}}' }}"

# commitizen only checks commit messages and PR titles here. scriv and scripts/release.py manage the changelog and the
# version, so `cz bump` and `cz changelog` are not used.
[tool.commitizen]
name = "cz_conventional_commits"
