{% raw %}
name: Image scan

# Build the image of the service each night and scan it for known vulnerabilities with trivy. A new CVE in the base
# image or in a locked dependency appears without a change in this repository, so a scan of each pull request is not
# enough. A finding opens an issue, or comments on the open one, so nothing fails without notice.
on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  scan:
    name: scan
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Build the image
        # --pull takes the newest base image of the tag, which is the image that a deploy would build tonight.
        run: docker build --pull --tag service:scan .
      - name: Scan the image
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: image
          image-ref: service:scan
          scanners: vuln
          severity: HIGH,CRITICAL
          ignore-unfixed: true
          exit-code: "1"
          format: table
          output: trivy-image.txt
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: always()
        with:
          name: trivy-image
          path: trivy-image.txt
          if-no-files-found: ignore

  report:
    name: report
    needs: scan
    if: failure()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: trivy-image
          path: /tmp/trivy
      - name: Open an issue, or comment on the open one
        env:
          GH_TOKEN: ${{ github.token }}
          TITLE: "Image scan: vulnerabilities in the service image"
        run: |
          {
            echo "The nightly image scan failed. Run: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
            echo
            echo "Fix: raise the locked dependency (\`uv lock --upgrade-package <name>\`) or the base image tag, then build again."
            echo
            echo '```text'
            head -c 50000 /tmp/trivy/trivy-image.txt 2>/dev/null || echo "The scan wrote no report. Read the run log."
            echo '```'
          } > /tmp/issue.md
          number=$(gh issue list --repo "$GITHUB_REPOSITORY" --state open --search "\"$TITLE\" in:title" --json number --jq '.[0].number')
          if [ -n "$number" ]; then
            gh issue comment "$number" --repo "$GITHUB_REPOSITORY" --body-file /tmp/issue.md
          else
            gh issue create --repo "$GITHUB_REPOSITORY" --title "$TITLE" --body-file /tmp/issue.md
          fi
{% endraw %}
