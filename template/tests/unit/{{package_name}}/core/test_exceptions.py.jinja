def test_untrusted_type_error_names_the_file_and_the_types() -> None:
    error = UntrustedTypeError(path="model.skops", types=["a.B", "c.D"])
    assert str(error) == "model.skops holds types that are not trusted: a.B, c.D"
    assert isinstance(error, {{ error_class }})
    assert isinstance(error, ValueError)
