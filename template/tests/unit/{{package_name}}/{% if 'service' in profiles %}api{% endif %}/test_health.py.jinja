"""Tests for the health route."""

from importlib.metadata import version

import pytest
from litestar.status_codes import HTTP_200_OK
from litestar.testing import AsyncTestClient

from {{ package_name }}.api.app import create_app

pytestmark = pytest.mark.anyio


async def test_health_reports_ok_and_the_version() -> None:
    async with AsyncTestClient(app=create_app()) as client:
        response = await client.get("/health")
    assert response.status_code == HTTP_200_OK
    assert response.json() == {"status": "ok", "version": version("{{ distribution_name }}")}
